    // MIHAK EGS_SS0026554 31-10-2014
    void allNewMeterReadingPerMeter(XmlNode _node)
    {
        XmlNode             instNode,instParentNode;
        XmlNodeList         instNodeList;
        XmlNodeListIterator instIterator;
        int                 instItemCnt;
        boolean             retFlag;
        boolean             unsaved;
        str                 meterNumSave;
    
        EGS_CreateReadingImportTable createReadingImportTable;
        ;
    
        retFlag = true;
        instNodeList=_node.selectNodes(#NODEVALUE_IN_newMeterReading); // (".//NewMeterReading")
        instItemCnt = instNodelist.length();
    
        if (instItemCnt == 0)
        {
            responseMsg = strfmt("@EGS5669",#NODEVALUE_IN_newMeterReading);
            this.addXMLnewMeterReading(this.xmlErrorResponse(this.document(),responseMsg));
            throw Error(responseMsg);
        }
    
        Entity_newMeterReading = EGS_API_Entity_newMeterReading::construct();
    
        instIterator = new XmlNodeListIterator(instNodelist);
        while (retFlag && instIterator.more())
        {
            instNode = instIterator.value();
    
            Entity_newMeterReading.alltags(instNode);
            retFlag = Entity_newMeterReading.checkFromNode();
            if (retFlag)
            {
                if (meterNumSave && Entity_newMeterReading.parmMeterNum() == meterNumSave)
                {
                    Entity_newMeterReading.addReadingForImport();
                    unsaved = true;
                }
    
                if (!meterNumSave || Entity_newMeterReading.parmMeterNum() != meterNumSave)
                {
                    //Not the first time, import meter readings on previous meter.
                    if (meterNumSave)
                    {
                        retFlag = Entity_newMeterReading.importReadings();
                        unsaved = false;
                        Entity_newMeterReading = EGS_API_Entity_newMeterReading::construct();
                    }
                    if (retFlag)
                    {
                        Entity_newMeterReading.initNewInstanceForImport();
                        Entity_newMeterReading.addReadingForImport();
                        unsaved = true;
                    }
                }
    
                instParentNode = instNode.parentNode();
                instParentNode.removeChild(instNode);
                instIterator.next();
    
                meterNumSave = Entity_newMeterReading.parmMeterNum();
            }
        }
    
        // Import meter readings on last meter
        if (retFlag && unsaved && Entity_newMeterReading != null)
        {
            retFlag = Entity_newMeterReading.importReadings();
        }
    
        this.addXMLnewMeterReading(Entity_newMeterReading.xmlnewMeterReadingResponse(this.document()));
    
    //    if (!retFlag)
    //    {
    //        responseMsg = "@EGS5628";
    //        throw Error(responseMsg);
    //    }
    
        return;
    }

