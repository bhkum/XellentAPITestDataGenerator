    public EGS_API_DataContract_Response newMeterReadingAPI(EGS_API_DataContract_NewMeterReadings _newMeterReadings)
    {
        return this.DataNewMeterReading(_newMeterReadings);
    }

    EGS_API_DataContract_Response DataNewMeterReading(EGS_API_DataContract_NewMeterReadings _newMeterReadings)
    {
        ListIterator            inIterator;
        int                     inItemCnt = 0;
        List list = _newMeterReadings.parmNewMeterReadings();
        EGS_API_DataContract_NewMeterReading newMeterReading;
    
        try
        {
            response = new EGS_API_DataContract_Response();
            ttsbegin;
            if (!list || list.elements() == 0)
            {
                responseMsg = strfmt("@EGU:RequiredListMissing", "@EGS:MeterReadings");
                response.parmMessage(responseMsg);
                throw Error(responseMsg);
            }
    
            inIterator = new ListIterator(list);
            while (inIterator.more())
            {
                newMeterReading = inIterator.value();
                response = this.allNewMeterReadingData(newMeterReading);
                
                //break the loop if reading is not created
                if (response.parmResponseCode() == #ResponseCode_OK)
                    inIterator.next();
                else 
                    break;
            }
    
            if (appl.ttsLevel() > 0)
            {
                ttscommit;
            }
    
            return response;
        }
        catch (Exception::Error)
        {
            if (!responseMsg)
            {
                responseMsg = EXU_Infolog::get().copyLastInfologText();
                response = this.dataErrorResponse(responseMsg);
            }
            return response;
        }
    }

    EGS_API_DataContract_Response allNewMeterReadingData(EGS_API_DataContract_NewMeterReading _newMeterReading)
    {
        XmlNode             instNode,instParentNode;
        XmlNodeList         instNodeList;
        XmlNodeListIterator instIterator;
        int                 instItemCnt;
        boolean             retFlag;
        boolean             firstTime = true;
    
        EGS_CreateReadingImportTable createReadingImportTable;
        ;
    
        retFlag = true;
        Entity_newMeterReading = EGS_API_Entity_newMeterReading::construct();
        retFlag = Entity_newMeterReading.initFromNodeData(_newMeterReading);

        if (retFlag)
        {
            if (firstTime)
            {
                Entity_newMeterReading.initNewInstanceForImport();
                firstTime = false;
            }
            Entity_newMeterReading.addReadingForImport();
        }
    
        if (retFlag && Entity_newMeterReading != null)
        {
            retFlag = Entity_newMeterReading.importReadings();
        }
    
        response = Entity_newMeterReading.dataNewMeterReadingResponse();
   
        return response;
    }

    EGS_API_DataContract_Response dataErrorResponse(str _responseMessage)
    {
        response = new EGS_API_DataContract_Response();
   
        response.parmResponseCode(#ResponseCode_NOT_OK);
        response.parmErrorCode(#ResponseErrorCode_8);
        response.parmMessage(_responseMessage);
    
        return response;
    }

