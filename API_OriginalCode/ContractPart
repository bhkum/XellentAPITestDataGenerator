    EGS_API_DataContract_Response dataNewContractPart(EGS_API_DataContract_NewContractParts _newContractParts)
    {
        ListIterator            inIterator;
        int                     inItemCnt = 0;
        List list = _newContractParts.parmNewContractParts();
        EGS_API_DataContract_NewContractPart_ContractPart contractPart;
    
        try
        {
            ttsbegin;
            response = new EGS_API_DataContract_Response();
            if (!list || list.elements() == 0)
            {
                responseMsg = strfmt("@EGU:RequiredListMissing", "@EGU8589");
                response.parmMessage(responseMsg);
                throw Error(responseMsg);
            }
    
            inIterator = new ListIterator(list);
            while (inIterator.more())
            {
                contractPart = inIterator.value();
                this.allNewContractPartData(contractPart);
                inIterator.next();
            }
            ttscommit;
            return response;
        }
        catch (Exception::Error)
        {
            if (!responseMsg)
            {
                responseMsg = EXU_Infolog::get().copyLastInfologText();
                response = this.dataErrorResponse(responseMsg);
            }
            return response;
        }
    }

    void allNewContractPartData(EGS_API_DataContract_NewContractPart_ContractPart _contractPart)
    {
        int                 instItemCnt,groupCnt;
        boolean             retFlag; 
        ;
    
        retFlag = true; 
    
        Entity_newContractPart = EGS_API_Entity_newContractPart::construct();
        retFlag = Entity_newContractPart.initFromNodeData(_contractPart);
        if (retFlag)
        {
            groupCnt = this.getSubnodeCountData(_contractPart) + 1;
            Entity_newContractPart.initMassFromNode(groupCnt);
            this.allPriceManagementData(_contractPart);    
            this.allFixedServiceData(_contractPart);
            this.allIndividualServiceData(_contractPart);
            this.allSecuredVolumeFlex(_contractPart);
            this.allSecuredVolumeDate(_contractPart);

        }
    
        response = Entity_newContractPart.dataNewContractPartResponse();
        if (!retFlag)
        {
            responseMsg = "@EGS5628";
            throw Error(responseMsg);
        }
   
        return;
    }

    EGS_API_DataContract_Response dataErrorResponse(str _responseMessage)
    {
        response = new EGS_API_DataContract_Response();
   
        response.parmResponseCode(#ResponseCode_NOT_OK);
        response.parmErrorCode(#ResponseErrorCode_8);
        response.parmMessage(_responseMessage);
    
        return response;
    }

