    XMLNode xmlErrorResponse(XMLDocument _document
                            ,str _responseMessage)
    {
        XMLNode     fatherNode, fieldNode;
        ;
    
        fatherNode = _document.createNode(XMLNodeType::ELEMENT, #NODEVALUE_Response, "");  // "Response"
    
        fieldNode = fatherNode.appendChild(_document.createElement(#NODEVALUE_ResponseCode));       // "ResponseCode"
        fieldNode.appendChild(_document.createTextNode(#ResponseCode_NOT_OK));            // "Not Ok"
        fieldNode = fatherNode.appendChild(_document.createElement(#NODEVALUE_ErrorCode));          // "ErrorCode"
        fieldNode.appendChild(_document.createTextNode(#ResponseErrorCode_8));            // "8"
        fieldNode = fatherNode.appendChild(_document.createElement(#NODEVALUE_ResponseMessage));    // "ResponseMessage"
        fieldNode.appendChild(_document.createTextNode(_responseMessage));
    
        return fatherNode;
    /*
    ResponseCode
    ErrorCode
    ResponseMessage
      */
    
    }

    void XmlnewContractPart(str _xml)
    {
        XmlDocument             indoc;
        XmlNode                 inRootNode,inNode,inParentNode;
        XmlNodeList             inNodeList;
        XmlNodeListIterator     inIterator;
        XMLParseError           xmlError;
        int                     inItemCnt = 0;
    
        try
        {
            ttsbegin;
            indoc = new XMLDocument();
    
            indoc.loadXml(_xml);
    //        indoc.load(_xml);
            xmlError = indoc.parseError();
            if (xmlError && xmlError.errorCode() != 0)
            {
                throw Error(xmlError.reason());
            }
    
            inRootNode = indoc.documentElement();
    
            inNodeList = indoc.selectNodes(#NODEVALUE_IN_Request); // ("//Request")
            inItemCnt = inNodeList.length();
    
            if (inItemCnt == 0)
            {
                responseMsg = strfmt("@EGS5669",#NODEVALUE_IN_Request);
                this.addXMLnewContractPart(this.xmlErrorResponse(this.document(),responseMsg));
                throw Error(responseMsg);
            }
    
            inIterator = new XmlNodeListIterator(inNodeList);
            while (inIterator.more())
            {
                inNode = inIterator.value();
                this.allNewContractParts(inNode);
                inParentNode = inNode.parentNode();
                inParentNode.removeChild(inNode);
                inIterator.next();
            }
            ttscommit;
            return;
        }
        catch (Exception::Error)
        {
            //--> ARS 29-03-2010 4.03.04 to 4.03.08 VAR upgrade
            // --- EGS_36366975YDO ink 2010-01-04 --->
            if (!responseMsg)
            {
                //Detail Cleanup-xxdja-09052016-Start
                responseMsg = EXU_Infolog::get().copyLastInfologText();
                //Detail Cleanup-xxdja-09052016-End
                this.addXMLnewContractPart(this.xmlErrorResponse(this.document(),responseMsg));
            }
            // <--- EGS_36366975YDO ink 2010-01-04 ---
            //<-- ARS 29-03-2010 4.03.04 to 4.03.08 VAR upgrade
    
            return;
        }
    }

