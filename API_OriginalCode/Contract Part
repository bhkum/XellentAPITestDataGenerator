        if (this.parmold_EndDate() == wDateNull)
            this.parmold_EndDate('');
        if (this.parmStartDate() == wDateNull)
            this.parmStartDate('');
        if (this.parmEndDate() == wDateNull)
            this.parmEndDate('');

        this.parmTechnicGroup1(_newContractPart.parmTechnicGroupContractPart1());
