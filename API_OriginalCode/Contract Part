    str dateTrim(str _indate)
    {
        int pos = strfind(_indate, 'T', 1, strlen(_indate));
        return pos > 1 ? substr(_indate, 1, pos-1) : _indate;
    }

    str getContractPartRecId()
    {
        EXU_ContractPartTable   exu_ContractPartTable;
        EXU_ContractPartEndDate exu_ContractPartEndDate; // EXU_SV0070302 MIFAL 2021-03-25
        ;
    
        // --> EXU_SV0070302 MIFAL 2021-04-09
        exu_ContractPartEndDate = str2date(this.parmold_EndDate(),321);

        select firstonly exu_ContractPartTable
               where exu_ContractPartTable.ContractNum == this.parmContractNum()
                  && exu_ContractPartTable.InstAgreeNum == this.parmInstAgreeNum()
                  && exu_ContractPartTable.DeliveryCategory == this.parmDeliveryCategory()
                  && exu_ContractPartTable.CompanyId == this.parmCompanyId()
                  && exu_ContractPartTable.ProductNum == this.parmold_ProductNum()
                  && exu_ContractPartTable.DeliveryGroupNum_RateCode == this.parmold_DeliveryGroupNum_RateCode()
                  && exu_ContractPartTable.Startdate == str2date(this.parmold_StartDate(),321)
                  && exu_ContractPartTable.EndDate == str2date(this.parmold_EndDate(),321);
        
        if(!exu_ContractPartTable && (this.parmSource() == 'Energiportalen_4'|| this.parmSource() == 'Energiportalen_1'))
        {
            select firstonly exu_ContractPartTable
                   where exu_ContractPartTable.ContractNum == this.parmContractNum()
                      && exu_ContractPartTable.InstAgreeNum == this.parmInstAgreeNum()
                      && exu_ContractPartTable.DeliveryCategory == this.parmDeliveryCategory()
                      && exu_ContractPartTable.CompanyId == this.parmCompanyId()
                      && exu_ContractPartTable.ProductNum == this.parmold_ProductNum()
                      && exu_ContractPartTable.DeliveryGroupNum_RateCode == this.parmold_DeliveryGroupNum_RateCode()
                      && exu_ContractPartTable.Startdate == str2date(this.parmold_StartDate(),321);
            {
                if(!exu_ContractPartTable && this.parmSource() == 'Energiportalen_1')
                {
                    select firstonly exu_ContractPartTable
                           where exu_ContractPartTable.ContractNum == this.parmContractNum()
                              && exu_ContractPartTable.InstAgreeNum == this.parmInstAgreeNum();
                }
                else 
                {
                    //below fake recid is just for OKAB portal, so they could craete the contract line
                    //without actually terminating existing one
                    if (this.parmSource() == 'Energiportalen_1')
                    {
                        exu_ContractPartTable.RecId = 102102;
                    }
                }
            }

        }
        //select firstonly exu_ContractPartTable
        //where exu_ContractPartTable.ContractNum == this.parmContractNum()
        //&& exu_ContractPartTable.InstAgreeNum == this.parmInstAgreeNum()
        //&& exu_ContractPartTable.DeliveryCategory == this.parmDeliveryCategory()
        //&& exu_ContractPartTable.CompanyId == this.parmCompanyId()
        //&& exu_ContractPartTable.ProductNum == this.parmold_ProductNum()
        //&& exu_ContractPartTable.DeliveryGroupNum_RateCode == this.parmold_DeliveryGroupNum_RateCode()
        //&& exu_ContractPartTable.Startdate == str2date(this.parmold_StartDate(),321)
        //&& exu_ContractPartTable.EndDate == str2date(this.parmold_EndDate(),321);
        // <-- EXU_SV0070302 MIFAL 2021-04-09
    
        if (exu_ContractPartTable.RecId)
            return int642str(exu_ContractPartTable.RecId);
        else
            return "";
    }

    EXU_MeteringPoint getMeteringPoint()
    {
        EXU_DelPoint    exu_DelPoint;
        ;
        select firstonly exu_DelPoint
        where exu_DelPoint.AttachmentNum == this.parmInstAgreeNum()
        && exu_DelPoint.DeliveryCategory == this.parmDeliveryCategory()
        && exu_DelPoint.CompanyId == this.parmCompanyId();
    
        if (exu_DelPoint.RecId)
            return exu_DelPoint.MeteringPoint;
        else
            return "";
    
    }

