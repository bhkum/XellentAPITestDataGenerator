        this.parmEnvironmentCode(_newContractPart.parmEnvironmentCode());
        this.parmContractPartSecuredVolumeFlex(_newContractPart.parmContractPartSecuredVolumeFlex());

        ret = this.checkFromNode();
    
        if (ret)
        {
            this.parmResponseCode(#ResponseCode_OK);
        }
        else
        {
            this.parmResponseCode(#ResponseCode_NOT_OK);
            this.parmResponseErrorCode(#ResponseErrorCode_4);
        }
   
        return(ret);
    }

