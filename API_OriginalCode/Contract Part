    boolean checkFromNode()
    {
        EXU_ContractTable   exu_ContractTable;
        boolean ret;
        ;
    
        ret = true;
    
        if (CustTable::find(this.parmAccountNum()))
        {
            if (this.parmContractNum())
            {
                exu_ContractTable = EXU_ContractTable::find(this.parmContractNum());
                if (exu_ContractTable.RecId)
                {
                    if (exu_ContractTable.CustAccount == this.parmAccountNum())
                    {
                        // --> EXU_SV0070302 2021-04-09 MIFAL
                        //if (!this.getContractPartRecId())
                        if (!this.getContractPartRecId() && this.parmSource() != 'Energiportalen_1')
                        // <-- EXU_SV0070302 2021-04-09 MIFAL
                        {
                            this.parmResponseMessage(strfmt("@EGS5986",this.parmContractNum(),this.parmProductNum()));
                            ret = false;
                        }
                    }
                    else
                    {
                        this.parmResponseMessage(strfmt("@EGS5734",this.parmContractNum(),this.parmAccountNum()));
                        ret = false;
                    }
                }
                else
                {
                    this.parmResponseMessage(strfmt("@EGS5626",this.parmContractNum()));
                    ret = false;
                }
            }
        }
        else
        {
            this.parmResponseMessage(strfmt("@EGS5659",this.parmAccountNum()));
            ret = false;
        }
        // --> FRGUL 2018-03-01 SV0052298
        if(ret == true)
        {
            ret = this.validate();
        }
        // <-- FRGUL 2018-03-01 SV0052298
  
        return ret;
    }

