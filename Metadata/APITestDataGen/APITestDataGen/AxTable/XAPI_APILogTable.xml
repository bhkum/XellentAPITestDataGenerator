				<Name>shouldThrowExceptionOnZeroDelete</Name>
				<Source><![CDATA[
    /// <summary>
    /// Determines if concurrent deletes should throw exception.
    /// </summary>
    /// <returns>true, if exception should be thrown; otherwise, false.</returns>
    public boolean shouldThrowExceptionOnZeroDelete()
    {
        return true;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getByKey</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static XAPI_APILogTable getByKey(XAPI_APIS _api, str _key)
    {
        XAPI_APILogTable logTable;

        select firstonly logTable 
            where logTable.ApiName == _api
            && logTable.Key == _key
            && logTable.Archived == NoYes::No;

        return logTable;

    }

]]></Source>
			</Method>
			<Method>
				<Name>getValueByKey</Name>
				<Source><![CDATA[
    public static str getValueByKey(XAPI_APIS _api, str _key)
    {
        return XAPI_APILogTable::getByKey(_api,_key).Value;
    }

]]></Source>
			</Method>
			<Method>
				<Name>archive</Name>
				<Source><![CDATA[
    /// <summary>
    ///
    /// </summary>
    public static void archive()
    {
        XAPI_APILogTable logTable;

        update_recordset logTable 
            setting Archived = NoYes::Yes
            where logTable.Archived == NoYes::No;

    }

]]></Source>
			</Method>
