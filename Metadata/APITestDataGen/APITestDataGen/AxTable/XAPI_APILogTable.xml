			<Method>
				<Name>getByKey</Name>
				<Source><![CDATA[
    /// <summary>
    /// Returns the most recent non-archived APIRunner log values row for the given
    /// API and field name. Callers use this to retrieve values created by earlier
    /// test cases (e.g. AccountNum generated by CreateCustomer).
    /// </summary>
    public static XAPI_APILogValues getByKey(XAPI_APIS _api, str _key)
    {
        XAPI_APILogValues logValues;
        XAPI_APILogTable  logTable;

        select firstonly logValues
            order by RecId desc
            join logTable
                where logTable.SessionId == logValues.SessionId
                    && logTable.Sequence  == logValues.Sequence
                    && logTable.ApiName   == _api
                    && logTable.Archived  == NoYes::No
                    && logValues.FieldName == _key;

        return logValues;
    }

]]></Source>
			</Method>
			<Method>
				<Name>getValueByKey</Name>
				<Source><![CDATA[
    public static str getValueByKey(XAPI_APIS _api, str _key)
    {
        return XAPI_APILogTable::getByKey(_api, _key).FieldValue;
    }

]]></Source>
			</Method>
			<Method>
				<Name>archive</Name>
				<Source><![CDATA[
    public static void archive()
    {
        XAPI_APILogTable logTable;

        update_recordset logTable
            setting Archived = NoYes::Yes
            where logTable.Archived == NoYes::No;
    }

]]></Source>
			</Method>
