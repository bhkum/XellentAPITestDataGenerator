			<Method>
				<Name>applySessionFilter</Name>
				<Source><![CDATA[
    /// <summary>
    /// Re-applies the SessionId range on the data source from the filter
    /// control's current text. Empty text clears the range.
    /// </summary>
    public void applySessionFilter()
    {
        QueryBuildDataSource    qbds;
        QueryBuildRange         range;
        str                     filterText;

        qbds = XAPI_APILogTable_ds.query().dataSourceTable(tableNum(XAPI_APILogTable));
        qbds.clearRange(fieldNum(XAPI_APILogTable, SessionId));

        filterText = SessionIdFilter.text();

        if (filterText)
        {
            range = qbds.addRange(fieldNum(XAPI_APILogTable, SessionId));
            range.value(queryValue(str2Guid(filterText)));
        }

        XAPI_APILogTable_ds.executeQuery();
    }

]]></Source>
			</Method>
		</Methods>
