						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            XAPI_APILogValues   logValues;
            XAPI_APILogTable    logTable;

            super();

            if (Box::okCancel("Clear all log records? This cannot be undone.", DialogButton::Cancel, "Clear log") == DialogButton::Ok)
            {
                ttsbegin;
                delete_from logValues;
                delete_from logTable;
                ttscommit;

                XAPI_APILogTable_ds.research();
                info("Log cleared.");
            }
        }

]]></Source>
