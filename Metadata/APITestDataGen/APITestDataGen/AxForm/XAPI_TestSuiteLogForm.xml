					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            XAPI_APILogTable    latestRow;

            super();

            select firstonly SessionId from latestRow
                order by RecId desc;

            if (latestRow.SessionId != emptyGuid())
            {
                SessionIdFilter.text(guid2Str(latestRow.SessionId));
                element.applySessionFilter();
            }
            else
            {
                info("No log rows found.");
            }
        }

]]></Source>
