						<Name>delete</Name>
						<Source><![CDATA[
        public void delete()
        {
            XAPI_APILogValues   logValues;

            ttsbegin;
            delete_from logValues
                where logValues.SessionId == XAPI_APILogTable.SessionId
                   && logValues.Sequence  == XAPI_APILogTable.Sequence;
            super();
            ttscommit;
        }

]]></Source>
