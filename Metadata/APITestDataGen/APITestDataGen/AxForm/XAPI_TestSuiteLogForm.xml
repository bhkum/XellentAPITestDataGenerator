					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource qbds = this.queryBuildDataSource();
            qbds.clearRanges();

            if (XAPI_APILogTable.RecId)
            {
                qbds.addRange(fieldNum(XAPI_APILogValues, SessionId))
                    .value(guid2Str(XAPI_APILogTable.SessionId));
                qbds.addRange(fieldNum(XAPI_APILogValues, Sequence))
                    .value(int2Str(XAPI_APILogTable.Sequence));
            }
            else
            {
                qbds.addRange(fieldNum(XAPI_APILogValues, SessionId))
                    .value(SysQuery::valueEmptyString());
            }

            super();
        }

]]></Source>
