				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        /// <summary>
        /// Runs the selected API's pre-processing class, following the same
        /// reflection pattern as XAPI_SuiteOrchestrator::runMain. The class name is
        /// read from XAPI_APIConfigurations.PreProcessClass for the selected API -
        /// that table is the single source of truth for the API -&gt; class mapping.
        /// </summary>
        public void clicked()
        {
            XAPI_APIS               api;
            XAPI_APIConfigurations  apiConfig;
            str                     className;
            ClassId                 classId;
            SysDictClass            dictClass;

            super();

            api = XAPI_ExecuteScripts.APIName;

            select firstonly apiConfig
                where apiConfig.API == api;

            if (!apiConfig.RecId)
            {
                error("No XAPI_APIConfigurations row is configured for the selected API.");
                return;
            }

            className = apiConfig.PreProcessClass;

            if (!className)
            {
                error("No pre-processing class is configured for the selected API in XAPI_APIConfigurations.");
                return;
            }

            classId = className2Id(className);
            if (!classId)
            {
                error(strFmt("Setup class %1 was not found.", className));
                return;
            }

            dictClass = new SysDictClass(classId);
            dictClass.callStatic('main', new Args());

            info(strFmt("Executed %1.", className));
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
