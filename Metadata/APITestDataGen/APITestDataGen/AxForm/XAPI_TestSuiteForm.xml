						<Source><![CDATA[
        public void clicked()
        {
            super();

            if (!XAPI_TestSuite.SuiteId)
            {
                warning("Select a test suite first.");
                return;
            }

            XAPI_TestSuiteCopyFromConfig::copyAll(XAPI_TestSuite.SuiteId);
            XAPI_TestCase_ds.research();
        }

]]></Source>
