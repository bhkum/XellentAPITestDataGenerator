						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            Dialog          dialog;
            DialogField     apiField;
            XAPI_APIS       selectedApi;
            super();
            if (!XAPI_TestSuite.SuiteId)
            {
                warning("Select a test suite first.");
                return;
            }
            dialog   = new Dialog("Copy single API config");
            apiField = dialog.addField(enumStr(XAPI_APIS), "API");
            if (dialog.run() && dialog.closedOk())
            {
                selectedApi = apiField.value();
                XAPI_TestSuiteCopyFromConfig::copySingle(XAPI_TestSuite.SuiteId, selectedApi);
                XAPI_TestCase_ds.research();
            }
        }

]]></Source>
