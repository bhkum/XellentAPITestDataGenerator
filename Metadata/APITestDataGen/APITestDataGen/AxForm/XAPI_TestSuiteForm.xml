					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource qbds = this.queryBuildDataSource();
            qbds.clearRanges();

            if (XAPI_TestSuite.SuiteId)
            {
                // Show only test cases for the currently selected suite
                qbds.addRange(fieldNum(XAPI_TestCase, SuiteId))
                    .value(XAPI_TestSuite.SuiteId);
            }
            else
            {
                // No suite selected — show nothing.
                // SuiteId is mandatory so no real record has empty SuiteId;
                // matching empty string therefore returns zero rows.
                qbds.addRange(fieldNum(XAPI_TestCase, SuiteId))
                    .value(SysQuery::valueEmptyString());
            }
            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            XAPI_TestCase   existing;
            super();

            if (!XAPI_TestSuite.SuiteId)
            {
                warning("Please create a test suite first.");
                return;
            }

            XAPI_TestCase.SuiteId = XAPI_TestSuite.SuiteId;
            select maxof(Sequence) from existing
                where existing.SuiteId == XAPI_TestSuite.SuiteId;
            XAPI_TestCase.Sequence    = existing.Sequence + 10;
            XAPI_TestCase.TestCaseId  = XAPI_TestSuiteCopyFromConfig::nextTestCaseId(XAPI_TestSuite.SuiteId);
        }

]]></Source>
