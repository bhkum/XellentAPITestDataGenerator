						<Source><![CDATA[
        public void clicked()
        {
            super();

            if (!XAPI_TestSuite.SuiteId)
            {
                warning("Select a test suite first.");
                return;
            }

            XAPI_SuiteOrchestrator::run(XAPI_TestSuite.SuiteId);
        }

]]></Source>
