				<Source><![CDATA[
[Form]
public class XAPI_TestSuiteForm extends FormRun
{
    int     lastSuiteNum;
    boolean formInitialized;

}
]]></Source>
			</Method>
			<Method>
				<Name>init</Name>
				<Source><![CDATA[
    public void init()
    {
        XAPI_TestSuite  existing;
        int             currentId;

        formInitialized = false; // BEFORE super() — keeps form empty on open
        super();
        JsonHtmlDisplay.allowEdit(false);

        // Calculate lastSuiteNum so next New gets correct ID (S003 after S001, S002)
        while select SuiteId from existing
        {
            if (existing.SuiteId)
            {
                currentId = str2int(subStr(existing.SuiteId, 2, strLen(existing.SuiteId) - 1));
                if (currentId > lastSuiteNum)
                {
                    lastSuiteNum = currentId;
                }
            }
        }
    }

]]></Source>
			</Method>
		</Methods>
