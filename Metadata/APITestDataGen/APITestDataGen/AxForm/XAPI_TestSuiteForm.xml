					<Method>
						<Name>executeQuery</Name>
						<Source><![CDATA[
        public void executeQuery()
        {
            QueryBuildDataSource qbds = this.queryBuildDataSource();
            qbds.clearRanges();

            if (!formInitialized)
            {
                // Block all records on form open
                qbds.addRange(fieldNum(XAPI_TestSuite, SuiteId))
                    .value("!");
            }
            super();
        }

]]></Source>
					</Method>
					<Method>
						<Name>selectionChanged</Name>
						<Source><![CDATA[
        public void selectionChanged()
        {
            super();
            // When switching S001 <-> S002, refresh test cases for selected suite
            XAPI_TestCase_ds.executeQuery();
        }

]]></Source>
					</Method>
					<Method>
						<Name>initValue</Name>
						<Source><![CDATA[
        public void initValue()
        {
            int             padding;
            str             numStr;
            str             newSuiteId;
            XAPI_TestCase   orphan;

            super();
            lastSuiteNum++;
            numStr  = strFmt("%1", lastSuiteNum);
            padding = 3 - strLen(numStr);
            if (padding < 0)
            {
                padding = 0;
            }
            newSuiteId = "S" + subStr("000", 1, padding) + numStr;
            XAPI_TestSuite.SuiteId = newSuiteId;

            // Clean up orphan test cases (left over from a previously deleted suite
            // that happened to use the same SuiteId). A new suite must start empty.
            ttsbegin;
            delete_from orphan
                where orphan.SuiteId == newSuiteId;
            ttscommit;

            formInitialized = true; // Unlock test cases after New is clicked
        }

]]></Source>
					</Method>
					<Method>
						<Name>validateDelete</Name>
						<Source><![CDATA[
        /// <summary>
        ///
        /// </summary>
        /// <returns></returns>
        public boolean validateDelete()
        {
            boolean         ret = super();
            XAPI_TestCase   testCase;

            select firstonly testCase
            where testCase.SuiteId == XAPI_TestSuite.SuiteId;

            if (testCase.SuiteId)
            {
                ret = checkFailed(strFmt("Cannot delete suite '%1'. Please delete all test cases first.", XAPI_TestSuite.SuiteId));
            }

            return ret;
        }

]]></Source>
					</Method>
