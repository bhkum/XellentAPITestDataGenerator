# ============================================================
# .gitignore for Dynamics 365 Finance & Operations (X++)
# Visual Studio Development
# ============================================================

# -----------------------------------------------
# Visual Studio
# -----------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# -----------------------------------------------
# D365 FO / AX Build Outputs
# -----------------------------------------------
# Compiled binaries and XPP artifacts
*.xppc
*.xpp.xml
*.label.xml

# Package / module bin output folders
*/bin/
Metadata/APITestDataGen/XppMetadata
*/Resources/
Metadata/APITestDataGen/Build*
!bin/XAI_OpenAI.dll


# -----------------------------------------------
# D365 FO Descriptor & Auto-generated Files
# -----------------------------------------------
# Do NOT ignore Descriptor XML (defines module metadata) — track it!
# But ignore auto-generated label files if regenerated on build:
# *.label.txt  ← uncomment if your labels are auto-generated

# -----------------------------------------------
# D365 FO Model Store / Database Exports
# -----------------------------------------------
*.axmodel
*.axmodelstore
*.bacpac
*.bak

# -----------------------------------------------
# Deployment & Packaging
# -----------------------------------------------
*.zip
DeployablePackage/
deployable-package/
PackagesLocalDirectory/
ScriptsPackage/

# -----------------------------------------------
# LCS / Azure DevOps Pipeline Artifacts
# -----------------------------------------------
BuildArtifacts/
TestResults/
*.trx
*.coverage
*.coveragexml

# -----------------------------------------------
# NuGet
# -----------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# -----------------------------------------------
# ReSharper / Rider
# -----------------------------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# -----------------------------------------------
# Windows & OS
# -----------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# -----------------------------------------------
# Node / Frontend (if using SysTest or UI tools)
# -----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------
# Logs & Temp Files
# -----------------------------------------------
*.log
*.tmp
*.temp
*.DS_Store
~$*

# -----------------------------------------------
# What TO track (common D365 FO source files)
# -----------------------------------------------
# These are tracked by default — listed here as a reminder:
# - *.xml         (model element metadata)
# - *.xpp         (X++ source code)
# - Descriptor/   (module descriptor XMLs)
# - AxTable/      (table definitions)
# - AxClass/      (class definitions)
# - AxForm/       (form definitions)
# - AxReport/     (report definitions)
# - AxQuery/      (query definitions)
# - AxEnum/       (enum definitions)
# - AxDataEntityView/
# - AxMenuItemDisplay/ AxMenuItemAction/ AxMenuItemOutput/

# - AxLabel/      (label files — *.label.txt)
# - AxResource/   (resources)